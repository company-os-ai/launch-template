# Per-launch config — fill in for THIS specific product launch.
# Secrets (VERCEL_TOKEN, STRIPE_API_KEY, APIFY_API_KEY) are NOT here —
# they live in $HOME/Corpus/Repositories/CompanyOS/.env and .env.ai.

# --- Vercel project ---
VERCEL_PROJECT_NAME="my-launch"            # also the .vercel.app subdomain

# --- Product copy ---
PRODUCT_NAME="My Launch"
PRODUCT_TAGLINE="A one-shot product."
INPUT_LABEL="Your input"
INPUT_PLACEHOLDER="example"
BUY_BUTTON_TEXT="Buy for $1"

# --- Stripe ---
# Filled in AFTER running ./scripts/setup-stripe.mjs (needs deployed URL first).
STRIPE_PAYMENT_LINK=""
STRIPE_PAYMENT_LINK_ID=""                  # plink_... (used to update success URL later)

# Plus any per-product fulfillment env vars your lib/fulfillment.ts uses.
