# --- Public (visible in browser; set via Vercel env) ---
NEXT_PUBLIC_PRODUCT_NAME="TokExport"
NEXT_PUBLIC_PRODUCT_TAGLINE="Full data export for any TikTok creator. $1."
NEXT_PUBLIC_INPUT_LABEL="TikTok handle"
NEXT_PUBLIC_INPUT_PLACEHOLDER="@mrbeast"
NEXT_PUBLIC_BUY_BUTTON_TEXT="Buy for $1"
NEXT_PUBLIC_STRIPE_PAYMENT_LINK="https://buy.stripe.com/xxxxxxxxxxxx"

# --- Stripe (server) ---
# Used to verify the checkout session was paid before serving the download.
STRIPE_SECRET_KEY="sk_live_..."

# --- Per-product fulfillment (override per launch) ---
# For TokExport (the default fulfillment):
TIKTOK_API_KEY=""
TIKTOK_API_URL="https://api.example.com/tiktok/profile"
